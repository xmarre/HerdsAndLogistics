<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>HerdsAndLogistics</AssemblyName>
    <RootNamespace>HerdsAndLogistics</RootNamespace>
    <Version>1.0.9</Version>
    <AssemblyVersion>1.0.9.0</AssemblyVersion>
    <FileVersion>1.0.9.0</FileVersion>
    <Description>Campaign herding, remount, and inventory logistics for Bannerlord 1.3.15-1.4.7.</Description>
    <BannerlordReferenceVersion Condition="'$(BannerlordReferenceVersion)' == ''">1.3.15.110062</BannerlordReferenceVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Bannerlord.ReferenceAssemblies" Version="$(BannerlordReferenceVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
